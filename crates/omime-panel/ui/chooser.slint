// The chooser: the input methods in a list, to browse with the keyboard or the pointer
// and choose one. In the colors and shapes of the switcher.

import { Look } from "look.slint";

export { Look }

export struct Row {
    // The input method's badge, its name, and its engine when that is another name.
    label: string,
    name: string,
    detail: string,
    // Where the user is in the list, and the input method in use.
    selected: bool,
    current: bool,
}

// A key, as on a keyboard.
component Keycap inherits Rectangle {
    in property <string> text;
    height: 20px;
    min-width: 20px;
    border-radius: 5px;
    background: Look.keycap;
    border-width: 1px;
    border-color: Look.border;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: 11px;
            color: Look.secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Keys and what they do.
component Hint inherits HorizontalLayout {
    in property <[string]> keys;
    in property <string> text;
    spacing: 4px;
    for key in root.keys: VerticalLayout {
        alignment: center;
        Keycap {
            text: key;
        }
    }
    Text {
        text: root.text;
        font-size: 12px;
        color: Look.secondary;
        vertical-alignment: center;
    }
}

export component Chooser inherits Window {
    title: "oh-my-ime";
    background: transparent;
    in property <[Row]> rows;
    // While the choice is on its way to omimed.
    in property <bool> busy;
    in property <string> heading;
    // The place in the list: "3 / 5".
    in property <string> counter;
    in property <string> error;
    // What the keys do, in the user's language.
    in property <string> browse;
    in property <string> select;
    in property <string> dismiss;
    callback navigate(int);
    callback edge(bool);
    callback pick(int);
    callback confirm();
    callback cancel();
    public function focus-keys() {
        keys.focus();
    }
    // How high the chooser has to be for its rows.
    out property <length> wanted-height: content.preferred-height;

    Rectangle {
        background: Look.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: Look.border;

        content := VerticalLayout {
            padding: 10px;
            spacing: 2px;
            HorizontalLayout {
                height: 30px;
                padding-left: 8px;
                padding-right: 10px;
                Text {
                    text: root.heading;
                    font-size: 13px;
                    font-weight: 600;
                    color: Look.secondary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.counter;
                    font-size: 12px;
                    color: Look.secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            for row[index] in root.rows: Rectangle {
                height: 48px;
                border-radius: 10px;
                background: row.selected ? Look.accent : touch.has-hover ? Look.hover : transparent;
                accessible-role: button;
                accessible-label: row.name;
                accessible-action-default => {
                    root.pick(index);
                }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 8px;
                            background: row.selected ? Look.badge-on-accent : Look.badge;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: row.label;
                                font-size: 16px;
                                font-weight: 600;
                                color: row.selected ? Look.on-accent : Look.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: clip;
                            }
                        }
                    }

                    Text {
                        text: row.name;
                        font-size: 15px;
                        color: row.selected ? Look.on-accent : Look.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    if row.detail != "": Text {
                        text: row.detail;
                        font-size: 12px;
                        color: row.selected ? Look.on-accent-secondary : Look.secondary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // The input method in use.
                    Text {
                        width: 16px;
                        text: row.current ? "✓" : "";
                        font-size: 15px;
                        color: row.selected ? Look.on-accent : Look.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                touch := TouchArea {
                    enabled: !root.busy;
                    clicked => {
                        root.pick(index);
                    }
                    scroll-event(event) => {
                        if event.delta-y != 0px {
                            root.navigate(event.delta-y < 0px ? 1 : -1);
                        }
                        accept
                    }
                }
            }

            if root.error != "": Text {
                height: 54px;
                text: root.error;
                font-size: 12px;
                color: Look.danger;
                wrap: word-wrap;
                vertical-alignment: center;
            }

            // A line, and what the keys do.
            Rectangle {
                height: 9px;
                Rectangle {
                    y: 5px;
                    height: 1px;
                    background: Look.divider;
                }
            }

            HorizontalLayout {
                height: 28px;
                padding-left: 8px;
                spacing: 16px;
                alignment: start;
                Hint {
                    keys: ["↑", "↓"];
                    text: root.browse;
                }

                Hint {
                    keys: ["Enter"];
                    text: root.select;
                }

                Hint {
                    keys: ["Esc"];
                    text: root.dismiss;
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if root.busy {
                return accept;
            }
            if event.text == Key.Escape {
                root.cancel();
            } else if event.text == Key.Return || event.text == " " {
                root.confirm();
            } else if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                root.navigate(-1);
            } else if event.text == Key.DownArrow || event.text == Key.RightArrow {
                root.navigate(1);
            } else if event.text == Key.Tab {
                root.navigate(event.modifiers.shift ? -1 : 1);
            } else if event.text == Key.PageUp {
                root.navigate(-6);
            } else if event.text == Key.PageDown {
                root.navigate(6);
            } else if event.text == Key.Home {
                root.edge(false);
            } else if event.text == Key.End {
                root.edge(true);
            }
            accept
        }
    }
}
