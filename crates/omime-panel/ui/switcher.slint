// The switcher: the input methods in a row for a moment, the one now in use
// highlighted.

import { Look } from "look.slint";

export { Look }

export struct Choice {
    label: string,
    name: string,
    current: bool,
}

export component Switcher inherits Window {
    in property <[Choice]> choices;
    // Fades the switcher in and out.
    in property <bool> shown;
    property <length> tile: 88px;
    property <length> gap: 6px;
    property <length> pad: 10px;
    out property <length> panel-width: max(1, choices.length) * tile + max(0, choices.length - 1) * gap + 2 * pad;
    out property <length> panel-height: tile + 2 * pad;
    background: transparent;

    Rectangle {
        border-radius: 18px;
        background: Look.panel;
        border-width: 1px;
        border-color: Look.border;
        opacity: root.shown ? 1 : 0;
        animate opacity {
            duration: 150ms;
            easing: ease-out;
        }

        HorizontalLayout {
            padding: root.pad;
            spacing: root.gap;
            for choice in root.choices: Rectangle {
                width: root.tile;
                height: root.tile;
                border-radius: 13px;
                background: choice.current ? Look.accent : transparent;

                VerticalLayout {
                    alignment: center;
                    padding: 6px;
                    spacing: 3px;
                    Text {
                        text: choice.label;
                        font-size: 30px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        color: choice.current ? Look.on-accent : Look.text;
                    }

                    Text {
                        text: choice.name;
                        font-size: 12px;
                        horizontal-alignment: center;
                        overflow: elide;
                        color: choice.current ? Look.on-accent-secondary : Look.secondary;
                    }
                }
            }
        }
    }
}
