import { Palette } from "std-widgets.slint";

// The colors of the settings window, light or dark as the desktop prefers. The widgets
// (buttons, switches, fields) are Fluent's and follow the same preference.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> window: dark ? #202020 : #f3f3f3;
    out property <brush> card: dark ? #2b2b2b : #ffffff;
    out property <brush> card-border: dark ? #ffffff10 : #0000000f;
    out property <brush> dialog: dark ? #2c2c2c : #fbfbfb;
    out property <brush> scrim: dark ? #00000080 : #0000004d;
    out property <brush> divider: dark ? #ffffff14 : #0000000f;
    out property <brush> text: dark ? #ffffff : #1b1b1b;
    out property <brush> secondary: dark ? #ffffffa6 : #00000094;
    out property <brush> tertiary: dark ? #ffffff66 : #00000066;
    out property <brush> hover: dark ? #ffffff0d : #00000008;
    out property <brush> selected: dark ? #ffffff17 : #0000000f;
    out property <brush> keycap: dark ? #ffffff14 : #00000008;
    out property <brush> accent: Palette.accent-background;
    out property <brush> on-accent: Palette.accent-foreground;
    out property <brush> success: dark ? #6ccb5f : #0f7b0f;
    out property <brush> danger: dark ? #ff99a4 : #c42b1c;
    out property <brush> danger-background: dark ? #442726 : #fde7e9;
}
