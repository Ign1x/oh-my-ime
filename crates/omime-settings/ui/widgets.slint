// The building blocks of the pages.

import { Switch } from "std-widgets.slint";
import { Theme } from "theme.slint";

// The title of a page and what it is about.
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 6px;
    padding-bottom: 8px;
    Text {
        text: root.title;
        font-size: 26px;
        font-weight: 600;
        color: Theme.text;
        accessible-role: none;
    }

    if root.description != "": Text {
        text: root.description;
        font-size: 13px;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}

// The heading of a group of cards.
export component SectionHeader inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

// A rounded box around rows.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-border;
    clip: true;
}

// The line between the rows of a card.
export component Divider inherits HorizontalLayout {
    in property <length> inset: 16px;
    padding-left: root.inset;
    height: 1px;
    Rectangle {
        background: Theme.divider;
    }
}

// A title and a line below it.
export component RowText inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    alignment: center;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: 14px;
        color: Theme.text;
        overflow: elide;
    }

    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 12px;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}

// A small square button with an icon, for the actions of a row.
export component IconButton inherits Rectangle {
    in property <image> icon;
    // What it does, for screen readers and tests.
    in property <string> label;
    in property <bool> enabled: true;
    in property <brush> tint: Theme.text;
    callback clicked;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    Image {
        source: root.icon;
        colorize: root.enabled ? root.tint : Theme.tertiary;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// An input method's badge: its label on the accent color.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <length> size: 36px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 4.5;
    background: Theme.accent;
    Text {
        text: root.text;
        color: Theme.on-accent;
        font-size: root.size * 0.44;
        font-weight: 600;
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: clip;
    }
}

// A short word on a tinted background, such as "In use".
export component Pill inherits Rectangle {
    in property <string> text;
    height: 20px;
    border-radius: 10px;
    background: Theme.accent.with-alpha(0.18);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 600;
            color: Theme.accent;
            vertical-alignment: center;
        }
    }
}

// A key of a hotkey, drawn as a keycap.
export component Keycap inherits Rectangle {
    in property <string> text;
    height: 28px;
    min-width: 28px;
    border-radius: 6px;
    background: Theme.keycap;
    border-width: 1px;
    border-color: Theme.card-border;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A row of a card with a switch.
export component SwitchRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> enabled: true;
    in-out property <bool> checked <=> switch.checked;
    callback toggled(bool);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    min-height: 64px;
    RowText {
        title: root.title;
        subtitle: root.subtitle;
        horizontal-stretch: 1;
    }

    VerticalLayout {
        alignment: center;
        switch := Switch {
            enabled: root.enabled;
            accessible-label: root.title;
            toggled => {
                root.toggled(self.checked);
            }
        }
    }
}

// An entry of the sidebar.
export component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked;
    height: 38px;
    border-radius: 6px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.clicked();
    }

    // The accent bar of the selected entry.
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: root.selected ? 16px : 0px;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height {
            duration: 150ms;
            easing: ease-out;
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: Theme.text;
                width: 18px;
                height: 18px;
            }
        }

        Text {
            text: root.text;
            font-size: 14px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
