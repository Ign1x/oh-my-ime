import { Button } from "std-widgets.slint";
import { Backend, Tr, View } from "../backend.slint";
import { Theme } from "../theme.slint";
import { Card, Divider, IconButton, Keycap, PageHeader, RowText } from "../widgets.slint";

// A hotkey, its keys and how to change it.
component HotkeyItem inherits Rectangle {
    // "toggle" or "next", as Backend knows them.
    in property <string> which;
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> keys;
    property <bool> recording: View.recording == root.which;
    min-height: 68px;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 10px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 12px;
        RowText {
            title: root.title;
            subtitle: root.subtitle;
            horizontal-stretch: 1;
        }

        if root.recording: Text {
            text: Tr.text("Press the new keys…");
            color: Theme.accent;
            vertical-alignment: center;
        }
        if !root.recording && root.keys.length == 0: Text {
            text: Tr.text("Off");
            color: Theme.tertiary;
            vertical-alignment: center;
        }
        if !root.recording && root.keys.length > 0: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                for key in root.keys: Keycap {
                    text: key;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Button {
                text: root.recording ? Tr.text("Cancel") : Tr.text("Change");
                accessible-label: root.recording ? Tr.text("Cancel") : Tr.text1("Change {}", root.title);
                clicked => {
                    if (root.recording) {
                        View.recording = "";
                    } else {
                        View.recording = root.which;
                        recorder.focus();
                    }
                }
            }
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("../icons/trash.svg");
                label: Tr.text1("Turn {} off", root.title);
                enabled: root.keys.length > 0 && !root.recording;
                clicked => {
                    Backend.clear-hotkey(root.which);
                }
            }
        }
    }

    // Takes the keys while recording.
    recorder := FocusScope {
        enabled: root.recording;
        key-pressed(event) => {
            if (Backend.record-key(root.which, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
                View.recording = "";
            }
            accept
        }
        changed has-focus => {
            // Clicking elsewhere ends the recording.
            if (!self.has-focus && root.recording) {
                View.recording = "";
            }
        }
    }
}

export component HotkeysPage inherits VerticalLayout {
    spacing: 12px;
    PageHeader {
        title: Tr.text("Hotkeys");
        description: Tr.text("Keys that switch input methods while you type in an application.");
    }

    Card {
        VerticalLayout {
            HotkeyItem {
                which: "toggle";
                title: Tr.text("Direct input and back");
                subtitle: Tr.text("Switches between direct input and the input method you used last");
                keys: Backend.toggle-keys;
            }

            Divider { }

            HotkeyItem {
                which: "next";
                title: Tr.text("Next input method");
                subtitle: Tr.text("Switches to the next input method in your list");
                keys: Backend.next-keys;
            }
        }
    }

    Text {
        text: Tr.text("To record keys, click Change and press them together; Escape cancels. Keys your compositor binds itself, such as Hyprland's binds, never reach oh-my-ime.");
        font-size: 12px;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}
