import { ComboBox } from "std-widgets.slint";
import { AppRow, Backend, Tr } from "../backend.slint";
import { Theme } from "../theme.slint";
import { Card, Divider, IconButton, PageHeader, RowText, SwitchRow } from "../widgets.slint";

// An application with its input method.
component AppItem inherits HorizontalLayout {
    in property <AppRow> app;
    padding-left: 16px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 12px;
    RowText {
        title: root.app.app;
        horizontal-stretch: 1;
    }

    VerticalLayout {
        alignment: center;
        ComboBox {
            width: 220px;
            model: Backend.app-choices;
            current-index: root.app.choice;
            accessible-label: Tr.text1("Input method of {}", root.app.app);
            selected => {
                Backend.set-app-input-method(root.app.app, self.current-index);
            }
        }
    }

    VerticalLayout {
        alignment: center;
        IconButton {
            icon: @image-url("../icons/trash.svg");
            label: Tr.text1("Forget {}", root.app.app);
            clicked => {
                Backend.forget-app(root.app.app);
            }
        }
    }
}

export component AppsPage inherits VerticalLayout {
    spacing: 12px;
    PageHeader {
        title: Tr.text("Applications");
        description: Tr.text("Each application can keep the input method you used in it last.");
    }

    Card {
        VerticalLayout {
            SwitchRow {
                title: Tr.text("Remember the input method of each application");
                subtitle: Tr.text("When you come back to an application, its input method comes back too");
                checked <=> Backend.remember-apps;
                toggled(on) => {
                    Backend.set-remember-apps(on);
                }
            }
            Divider { }
            SwitchRow {
                title: Tr.text("Remember the input mode of each application");
                subtitle: Tr.text("Restore Chinese or Latin mode within the same input method when supported");
                checked <=> Backend.remember-mode;
                enabled: Backend.remember-apps;
                toggled(on) => {
                    Backend.set-remember-mode(on);
                }
            }
        }
    }

    if Backend.remember-apps && Backend.apps.length > 0: Card {
        VerticalLayout {
            for app[index] in Backend.apps: VerticalLayout {
                if index > 0: Divider { }
                AppItem {
                    app: app;
                }
            }
        }
    }

    if Backend.remember-apps && Backend.apps.length == 0: Text {
        text: Tr.text("No application has an input method of its own yet: switch input methods in one, and it shows here.");
        font-size: 12px;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}
