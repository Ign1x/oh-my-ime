// oh-my-ime's settings window: a sidebar with the pages, the page, and the list of input
// methods to add over it when it is open.

import { ScrollView } from "std-widgets.slint";
import { Backend, Texts, Tr, View } from "backend.slint";
import { Theme } from "theme.slint";
import { Card, IconButton, NavItem } from "widgets.slint";
import { AddDialog, InputMethodsPage } from "pages/input-methods.slint";
import { HotkeysPage } from "pages/hotkeys.slint";
import { AppsPage } from "pages/apps.slint";
import { GeneralPage } from "pages/general.slint";
import { AboutPage } from "pages/about.slint";

export { Backend, Texts, Tr, View }
export { AppRow, CatalogEntry, Check, InputMethodRow } from "backend.slint";

// What failed, over the page until dismissed.
component ErrorBanner inherits Rectangle {
    in property <string> text;
    background: Theme.danger-background;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.danger-border;
    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/alert.svg");
                colorize: Theme.danger;
                width: 18px;
                height: 18px;
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/close.svg");
                label: Tr.text("Dismiss");
                tint: Theme.text;
                clicked => {
                    Backend.dismiss-error();
                }
            }
        }
    }
}

// What the window shows while omimed does not run.
component NotRunning inherits VerticalLayout {
    alignment: center;
    vertical-stretch: 1;
    padding: 32px;
    HorizontalLayout {
        alignment: center;
        Card {
            max-width: 440px;
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px;
                spacing: 12px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        border-radius: 14px;
                        background: Theme.surface-subtle;
                        border-width: 1px;
                        border-color: Theme.card-border;
                        Image {
                            source: @image-url("icons/alert.svg");
                            colorize: Theme.tertiary;
                            width: 26px;
                            height: 26px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                Text {
                    text: Backend.loaded ? Tr.text("oh-my-ime is not running") : Tr.text("Connecting to oh-my-ime…");
                    font-size: 19px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }

                if Backend.loaded: Text {
                    text: Tr.text("Start it with “systemctl --user start omimed”, or run omimed. The settings show here as soon as it runs.");
                    font-size: 13px;
                    color: Theme.secondary;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Quiet real-data daemon status shown at the foot of the navigation rail.
component DaemonStatusCard inherits Rectangle {
    background: Theme.card;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.card-border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: !Backend.connected ? Theme.tertiary : Backend.seat-taken ? Theme.danger : Theme.success;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: !Backend.connected
                    ? (Backend.loaded ? Tr.text("Daemon offline") : Tr.text("Connecting…"))
                    : Backend.seat-taken
                        ? Tr.text("Seat occupied")
                        : Tr.text("Daemon running");
                font-size: 12px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }

            if Backend.connected && Backend.daemon-version != "": Text {
                text: "omimed " + Backend.daemon-version;
                font-size: 11px;
                color: Theme.secondary;
                overflow: elide;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: Tr.text("oh-my-ime Settings");
    preferred-width: 920px;
    preferred-height: 660px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.window;
    default-font-size: 14px;

    property <length> sidebar-width: 208px;
    property <length> page-padding: 24px;

    HorizontalLayout {
        // Navigation rail.
        Rectangle {
            width: root.sidebar-width;
            background: Theme.sidebar;

            VerticalLayout {
                padding: 12px;
                padding-top: 18px;
                padding-bottom: 12px;
                spacing: 3px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-bottom: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: Theme.navy;
                            Image {
                                source: @image-url("icons/keyboard.svg");
                                colorize: Theme.on-navy;
                                width: 18px;
                                height: 18px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "oh-my-ime";
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }
                    }
                }

                NavItem {
                    icon: @image-url("icons/keyboard.svg");
                    text: Tr.text("Input methods");
                    selected: View.page == 0;
                    clicked => {
                        View.page = 0;
                    }
                }

                NavItem {
                    icon: @image-url("icons/command.svg");
                    text: Tr.text("Hotkeys");
                    selected: View.page == 1;
                    clicked => {
                        View.page = 1;
                    }
                }

                NavItem {
                    icon: @image-url("icons/apps.svg");
                    text: Tr.text("Applications");
                    selected: View.page == 2;
                    clicked => {
                        View.page = 2;
                    }
                }

                NavItem {
                    icon: @image-url("icons/sliders.svg");
                    text: Tr.text("General");
                    selected: View.page == 3;
                    clicked => {
                        View.page = 3;
                    }
                }

                NavItem {
                    icon: @image-url("icons/info.svg");
                    text: Tr.text("About");
                    selected: View.page == 4;
                    clicked => {
                        View.page = 4;
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                DaemonStatusCard { }
            }

            // Hairline separator between navigation rail and content canvas.
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.divider;
            }
        }

        // Page content area.
        VerticalLayout {
            horizontal-stretch: 1;
            if !Backend.connected: NotRunning { }
            if Backend.connected && Backend.error != "": HorizontalLayout {
                padding-top: 16px;
                padding-left: root.page-padding;
                padding-right: root.page-padding;
                alignment: center;
                ErrorBanner {
                    min-width: 0px;
                    preferred-width: 720px;
                    max-width: 720px;
                    horizontal-stretch: 1;
                    text: Backend.error;
                }
            }
            if Backend.connected: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    // Pages take the height they need, at the top.
                    alignment: start;
                    padding-top: 24px;
                    padding-bottom: 32px;
                    padding-left: root.page-padding;
                    padding-right: root.page-padding;
                    HorizontalLayout {
                        alignment: center;
                        VerticalLayout {
                            min-width: 0px;
                            preferred-width: 720px;
                            max-width: 720px;
                            horizontal-stretch: 1;
                            if View.page == 0: InputMethodsPage { }
                            if View.page == 1: HotkeysPage { }
                            if View.page == 2: AppsPage { }
                            if View.page == 3: GeneralPage { }
                            if View.page == 4: AboutPage { }
                        }
                    }
                }
            }
        }
    }

    if Backend.connected && View.adding: AddDialog {
        width: root.width;
        height: root.height;
    }
}
