# Simplified Chinese translation of omime-settings.
# Terms follow docs/zh-CN: 热键, 切换浮层, 托盘, 直接输入.
msgid ""
msgstr ""
"Project-Id-Version: omime-settings\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "oh-my-ime Settings"
msgstr "oh-my-ime 设置"

msgid "Input methods"
msgstr "输入法"

msgid "Hotkeys"
msgstr "热键"

msgid "Applications"
msgstr "应用"

msgid "General"
msgstr "通用"

msgid "About"
msgstr "关于"

msgid "Dismiss"
msgstr "关闭提示"

msgid "Connecting to oh-my-ime…"
msgstr "正在连接 oh-my-ime…"

msgid "oh-my-ime is not running"
msgstr "oh-my-ime 没有运行"

msgid "Start it with “systemctl --user start omimed”, or run omimed. The settings show here as soon as it runs."
msgstr "用“systemctl --user start omimed”启动它，或者直接运行 omimed。它一运行，设置就会出现在这里。"

msgid "Direct input"
msgstr "直接输入"

msgid "The input methods you switch between, in the order of switching. Direct input is always there too."
msgstr "在这些输入法之间切换，顺序即切换顺序。直接输入始终可用。"

msgid "In use"
msgstr "正在使用"

msgid "Move {} up"
msgstr "上移{}"

msgid "Move {} down"
msgstr "下移{}"

msgid "Settings of {}"
msgstr "{}的设置"

msgid "Remove {}"
msgstr "移除{}"

msgid "No input methods yet"
msgstr "还没有输入法"

msgid "Add one to type in another language."
msgstr "添加一个，就能输入其他语言。"

msgid "Add input method…"
msgstr "添加输入法…"

msgid "Add an input method"
msgstr "添加输入法"

msgid "Close"
msgstr "关闭"

msgid "Search"
msgstr "搜索"

msgid "Add"
msgstr "添加"

msgid "Add {}"
msgstr "添加{}"

msgid "Every input method there is is in your list already. Install another framework or engine to get more."
msgstr "所有可用的输入法都已在列表里。安装其他输入法框架或引擎，可以获得更多。"

msgid "No input method matches “{}”."
msgstr "没有与“{}”匹配的输入法。"

msgid "Chinese (Simplified)"
msgstr "简体中文"

msgid "Chinese (Traditional)"
msgstr "繁体中文"

msgid "Chinese"
msgstr "中文"

msgid "Japanese"
msgstr "日语"

msgid "Korean"
msgstr "韩语"

msgid "English"
msgstr "英语"

msgid "Vietnamese"
msgstr "越南语"

msgid "Thai"
msgstr "泰语"

msgid "Other"
msgstr "其他"

msgid "Keys that switch input methods while you type in an application."
msgstr "在应用里打字时，用这些按键切换输入法。"

msgid "Direct input and back"
msgstr "切换直接输入"

msgid "Switches between direct input and the input method you used last"
msgstr "在直接输入和上次用的输入法之间切换"

msgid "Next input method"
msgstr "下一个输入法"

msgid "Switches to the next input method in your list"
msgstr "切换到列表里的下一个输入法"

msgid "Press the new keys…"
msgstr "请按下新的按键…"

msgid "Off"
msgstr "未设置"

msgid "Cancel"
msgstr "取消"

msgid "Change"
msgstr "更改"

msgid "Change {}"
msgstr "更改“{}”"

msgid "Turn {} off"
msgstr "关闭“{}”"

msgid "To record keys, click Change and press them together; Escape cancels. Keys your compositor binds itself, such as Hyprland's binds, never reach oh-my-ime."
msgstr "点“更改”，然后同时按下新的组合键即可录制；按 Esc 取消。合成器自己绑定的按键（如 Hyprland 的 bind）不会传给 oh-my-ime。"

msgid "Each application can keep the input method you used in it last."
msgstr "每个应用都可以记住你上次在其中使用的输入法。"

msgid "Remember the input method of each application"
msgstr "为每个应用记住输入法"

msgid "When you come back to an application, its input method comes back too"
msgstr "回到某个应用时，自动换回它的输入法"

msgid "Input method of {}"
msgstr "{}的输入法"

msgid "Forget {}"
msgstr "忘记{}"

msgid "No application has an input method of its own yet: switch input methods in one, and it shows here."
msgstr "还没有应用记住了输入法：在某个应用里切换一次输入法，它就会出现在这里。"

msgid "Show in the tray"
msgstr "在托盘中显示"

msgid "An icon in the status bar shows the input method in use, and its menu switches"
msgstr "状态栏里的图标显示正在使用的输入法，从它的菜单可以切换"

msgid "Show the switcher"
msgstr "显示切换浮层"

msgid "Your input methods appear for a moment when you switch with the hotkeys"
msgstr "用热键切换时，屏幕上会短暂显示你的输入法"

msgid "Waiting for an input method"
msgstr "等待输入法的时间"

msgid "How long a key waits for the input method's answer before it goes to the application as it is"
msgstr "按键等待输入法回应的最长时间，超时后按键原样交给应用"

msgid "omimed {}, settings {}"
msgstr "omimed {}，设置程序 {}"

msgid "Status"
msgstr "状态"

msgid "Connected to the compositor at {}"
msgstr "已连接合成器 {}"

msgid "oh-my-ime is the input method of seat {}"
msgstr "oh-my-ime 是座位 {} 的输入法"

msgid "Another input method holds seat {}"
msgstr "座位 {} 被另一个输入法占用"

msgid "The compositor reports which application has focus"
msgstr "合成器会报告哪个应用有焦点"

msgid "The compositor does not report which application has focus, so applications cannot keep their input method"
msgstr "合成器不报告哪个应用有焦点，因此应用无法记住各自的输入法"

msgid "The input method could not be selected: {}"
msgstr "无法选中输入法：{}"

msgid "For a full check of your setup, run “omime doctor” in a terminal. omimed's log: “journalctl --user -u omimed”."
msgstr "要全面检查设置，请在终端运行“omime doctor”。omimed 的日志：“journalctl --user -u omimed”。"
