[Unit]
Description=oh-my-ime input method daemon
Documentation=https://github.com/Ign1x/oh-my-ime
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.ign1x.OhMyIme
# Adjust if omimed is installed elsewhere (e.g. /usr/bin/omimed).
ExecStart=%h/.local/bin/omimed
# Fails, and says why, when config.toml has a mistake.
ExecReload=%h/.local/bin/omime reload
Restart=on-failure
RestartPreventExitStatus=69
RestartSec=1
# Let omimed send native Shutdown before stopping the engines in its cgroup.
KillMode=mixed
TimeoutStopSec=6

[Install]
WantedBy=graphical-session.target
