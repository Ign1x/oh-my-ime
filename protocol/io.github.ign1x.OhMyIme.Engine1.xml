<?xml version="1.0" encoding="UTF-8"?>
<!--
  oh-my-ime engine protocol, version 1.2.

  Version 1.2 adds context-bound input modes (SetInputMode, ReportInputMode and
  action kind 4). Engines advertise stable mode IDs in the Register capability
  "input-modes" (as); empty/absent means unsupported. Only use these additions
  when both peers support minor version 2 or later.

  Version 1.1 adds input methods of an engine's own (SetInputMethods,
  SetCurrentInputMethod, SelectInputMethod) and its menu (SetProperties,
  ActivateProperty). The daemon calls SelectInputMethod and ActivateProperty only on
  engines that registered with minor version 1 or later.

  Each engine process talks to the daemon over its own peer-to-peer D-Bus connection.
  The address is passed in the OMIME_ENGINE_ADDRESS environment variable, and the
  engine's id in OMIME_ENGINE_ID.

  The engine exports io.github.ign1x.OhMyIme.Engine1 at /io/github/ign1x/OhMyIme/Engine.
  The daemon exports io.github.ign1x.OhMyIme.EngineHost1 at /io/github/ign1x/OhMyIme.

  Conventions
  - Offsets and lengths into text are UTF-8 byte counts, as in zwp_text_input_v3.
  - Dictionaries (a{sv}) may gain keys in minor versions. Ignore keys you don't know.
  - Methods that return actions (a(uv)) apply them in order, before anything that
    happens later. An action is (kind, payload):
      0 commit              s       insert text, replacing the preedit
      1 preedit             (sii)   text, cursor begin, cursor end (-1 hides the cursor);
                                    empty text clears the preedit
      2 delete-surrounding  (uu)    bytes before and after the cursor
      3 forward-key         (ub)    evdev key code, pressed
      4 input-mode          (sst)   confirmed engine-local input method ID (empty
                                    without submethods), stable mode ID, monotonically
                                    increasing revision per connection; since 1.2
    Unknown kinds must be ignored by the daemon.

  Context dictionary keys (Activate, UpdateContext)
    app-id              s     app id of the focused window, when the compositor
                              reports it (wlr-foreign-toplevel-management)
    content-purpose     u     zwp_text_input_v3 content_purpose
    content-hints       u     zwp_text_input_v3 content_hint bits
    surrounding-text    s     text around the cursor
    surrounding-cursor  u     cursor, bytes into surrounding-text
    surrounding-anchor  u     selection anchor, bytes into surrounding-text
    cursor-rect         (iiii) text cursor relative to the engine's popup window
    frontend            s     how the application reaches the daemon: "wayland"
                              (text-input), "xim" or "fcitx" (the Fcitx5 GTK/Qt
                              modules); since 0.4
    client-preedit      b     whether the application shows the preedit; when false
                              (xterm and other XIM applications that leave drawing it
                              to the input method) an engine with a window shows it
                              there; true when absent; since 0.4
-->
<node>
  <interface name="io.github.ign1x.OhMyIme.Engine1">
    <!--
      The engine is now responsible for a focused text field. Fields with sensitive
      content (passwords, PINs) are never given to engines.
    -->
    <method name="Activate">
      <arg name="context" type="t" direction="in"/>
      <arg name="info" type="a{sv}" direction="in"/>
      <arg name="actions" type="a(uv)" direction="out"/>
    </method>

    <!--
      The text field lost focus, or another engine was selected. The daemon removes any
      preedit from the field itself.
    -->
    <method name="Deactivate">
      <arg name="context" type="t" direction="in"/>
    </method>

    <!-- Some properties of the text field changed; only changed keys are present. -->
    <method name="UpdateContext">
      <arg name="context" type="t" direction="in"/>
      <arg name="changes" type="a{sv}" direction="in"/>
      <arg name="actions" type="a(uv)" direction="out"/>
    </method>

    <!--
      A key was pressed or released.
      key: (keysym, evdev keycode, modifiers, time in ms, text, released, repeat).
      Modifier bits: Shift 1, CapsLock 2, Control 4, Alt 8, NumLock 16, Super 64.
      text is what the key types under the current layout and modifiers. It never
      contains control characters: it is empty for Return, Tab, Escape, BackSpace and
      for most keys pressed with Control.
      Return handled=true to consume the key. Releases are routed like their presses
      regardless of the answer, so applications never see stuck keys.
      If the engine does not answer within the daemon's timeout (200 ms by default),
      the key is passed to the application and the late answer is discarded.
    -->
    <method name="ProcessKey">
      <arg name="context" type="t" direction="in"/>
      <arg name="key" type="(uuuusbb)" direction="in"/>
      <arg name="extras" type="a{sv}" direction="in"/>
      <arg name="handled" type="b" direction="out"/>
      <arg name="actions" type="a(uv)" direction="out"/>
    </method>

    <!-- The application changed the text on its own; drop any composition. -->
    <method name="Reset">
      <arg name="context" type="t" direction="in"/>
      <arg name="actions" type="a(uv)" direction="out"/>
    </method>

    <!--
      Since 1.2. Restore an advertised mode of the context's current input method.
      Runs in the same ordered queue as Activate, Reset and ProcessKey. Confirm
      the actual resulting mode with action kind 4; an empty reply does not confirm
      success. An unsupported mode must leave the engine unchanged. The daemon
      rejects stale replies after focus, input method or engine generation changes.
    -->
    <method name="SetInputMode">
      <arg name="context" type="t" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg name="actions" type="a(uv)" direction="out"/>
    </method>

    <!-- The daemon asks the engine to exit. -->
    <method name="Shutdown"/>

    <!--
      Since 1.1. The user chose one of the input methods the engine announced with
      SetInputMethods. Switch to it and confirm with SetCurrentInputMethod.
    -->
    <method name="SelectInputMethod">
      <arg name="id" type="s" direction="in"/>
    </method>

    <!--
      Since 1.1. The user activated an entry of the menu the engine announced with
      SetProperties: an action, a toggle or a radio entry. Act on it, and announce the
      menu again if that changed it (a toggle flipped, another radio entry chosen).
    -->
    <method name="ActivateProperty">
      <arg name="id" type="s" direction="in"/>
    </method>
  </interface>

  <interface name="io.github.ign1x.OhMyIme.EngineHost1">
    <!--
      Must be the first call. id must equal OMIME_ENGINE_ID. Returns the session
      parameters, currently "api-major" (q), "api-minor" (q) and "daemon-version" (s).
    -->
    <method name="Register">
      <arg name="id" type="s" direction="in"/>
      <arg name="api_major" type="q" direction="in"/>
      <arg name="api_minor" type="q" direction="in"/>
      <arg name="capabilities" type="a{sv}" direction="in"/>
      <arg name="session" type="a{sv}" direction="out"/>
    </method>

    <!--
      Out-of-band actions, for example after the user clicked a candidate in the
      engine's window. They are ignored if the context is no longer focused.
    -->
    <method name="Commit">
      <arg name="context" type="t" direction="in"/>
      <arg name="text" type="s" direction="in"/>
    </method>
    <method name="SetPreedit">
      <arg name="context" type="t" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="cursor_begin" type="i" direction="in"/>
      <arg name="cursor_end" type="i" direction="in"/>
    </method>
    <method name="DeleteSurrounding">
      <arg name="context" type="t" direction="in"/>
      <arg name="before" type="u" direction="in"/>
      <arg name="after" type="u" direction="in"/>
    </method>
    <method name="ForwardKey">
      <arg name="context" type="t" direction="in"/>
      <arg name="keycode" type="u" direction="in"/>
      <arg name="pressed" type="b" direction="in"/>
    </method>

    <!--
      Since 1.2. A mode changed outside an engine callback, e.g. in its menu.
      Report the actual mode and engine-local input method (empty without
      submethods). Stale contexts, methods and engine generations are ignored.
      During ordered callbacks, return action kind 4 instead so confirmation stays
      ordered with text effects and key handling. Both forms share one increasing
      revision sequence, starting at 1, allocated when the actual mode is observed
      before sending it. Older reports cannot replace newer observations even when
      asynchronous messages reach the daemon before earlier method replies.
    -->
    <method name="ReportInputMode">
      <arg name="context" type="t" direction="in"/>
      <arg name="input_method" type="s" direction="in"/>
      <arg name="mode" type="s" direction="in"/>
      <arg name="revision" type="t" direction="in"/>
    </method>

    <!--
      Whether the engine's windows should be shown while it is active. Engines must
      not hide their toolkit windows themselves; the platform shows and hides them.
      Windows are hidden until the engine asks for them with SetPopupVisible(true).
    -->
    <method name="SetPopupVisible">
      <arg name="visible" type="b" direction="in"/>
    </method>

    <!--
      Status for panels and the CLI: "label" (s), "icon" (s), "tooltip" (s).
      The daemon exposes "input-mode" (s, since 1.2) in its status dictionary only
      from accepted context-bound mode confirmations; SetStatus is not a mode report.
    -->
    <method name="SetStatus">
      <arg name="status" type="a{sv}" direction="in"/>
    </method>

    <!-- Ask the daemon to switch to another engine; "" selects direct input. -->
    <method name="RequestSwitch">
      <arg name="engine" type="s" direction="in"/>
    </method>

    <!--
      Since 1.1. The engine has input methods of its own, such as the schemas of a
      Rime engine, which users choose like the input methods inside hosted frameworks
      (`engine/id` in Switch, the tray menu and config.toml). Each entry: "id" (s,
      [A-Za-z0-9._-]), "name", "icon", "label" (s, a short label such as 双),
      "language" (s, BCP 47). current: the one in use, empty for none. Call it again
      whenever the list changes.
    -->
    <method name="SetInputMethods">
      <arg name="input_methods" type="aa{sv}" direction="in"/>
      <arg name="current" type="s" direction="in"/>
    </method>

    <!-- Since 1.1. The input method in use changed, also when the engine switched on its own. -->
    <method name="SetCurrentInputMethod">
      <arg name="id" type="s" direction="in"/>
    </method>

    <!--
      Since 1.1. The engine's menu, which the platform shows in its tray menu and
      settings while the engine is in use: actions and switches such as Chinese or
      English punctuation, full or half width. Each entry: "id" (s, unique), "parent"
      (s, the id of the "menu" entry it is in, empty at the top), "kind" (s: "action",
      "toggle", "radio", "menu" or "separator"; unknown kinds are actions), "label",
      "icon" (an icon name), "tooltip" (s), "checked" (b: a toggle is on, a radio entry
      chosen), "enabled" (b, true when missing). Entries come in menu order; radio
      entries with the same parent are one choice. Call it again with the whole menu
      whenever anything in it changes. The menu is forgotten when the engine exits.
    -->
    <method name="SetProperties">
      <arg name="properties" type="aa{sv}" direction="in"/>
    </method>
  </interface>
</node>
