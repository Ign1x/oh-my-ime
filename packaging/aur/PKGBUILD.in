# Generated by scripts/package-linux.py from the release manifest.
# Source revision: @REVISION@
@METADATA@

_release_version='@RELEASE_VERSION@'

_install_component() {
  local component="$1" package="$2" prefix='oh-my-ime' engine manifest
  [[ "$component" == 'rime' ]] && prefix='oh-my-ime-rime'
  local payload="$srcdir/$prefix-$_release_version-$CARCH-linux"

  install -dm755 "$pkgdir/usr/bin" "$pkgdir/usr/share"
  install -m755 "$payload/bin/"* "$pkgdir/usr/bin/"
  cp -a "$payload/share/." "$pkgdir/usr/share/"
  mv "$pkgdir/usr/share/licenses/oh-my-ime" "$pkgdir/usr/share/licenses/$package"
  install -Dm644 "$payload/README.txt" "$pkgdir/usr/share/doc/$package/README.release"

  # Native engines must not depend on the user's PATH.
  for engine in echo sparkle ibus rime; do
    manifest="$pkgdir/usr/share/oh-my-ime/engines/$engine/engine.toml"
    if [[ -f "$manifest" ]]; then
      sed -i "s|\[\"omime-$engine\"|[\"/usr/bin/omime-$engine\"|g" "$manifest"
    fi
  done
}

package_oh-my-ime-bin() {
@PLATFORM_METADATA@
  _install_component platform oh-my-ime-bin

  install -dm755 "$pkgdir/usr/lib/systemd/user"
  mv "$pkgdir/usr/share/systemd/user/omimed.service" "$pkgdir/usr/lib/systemd/user/"
  rmdir "$pkgdir/usr/share/systemd/user" "$pkgdir/usr/share/systemd"
  sed -i \
    -e 's|ExecStart=%h/.local/bin/omimed|ExecStart=/usr/bin/omimed|' \
    -e 's|ExecReload=%h/.local/bin/omime reload|ExecReload=/usr/bin/omime reload|' \
    -e '/^# Adjust if omimed is installed elsewhere/d' \
    "$pkgdir/usr/lib/systemd/user/omimed.service"
  sed -i 's|Exec=omime-settings|Exec=/usr/bin/omime-settings|' \
    "$pkgdir/usr/share/applications/io.github.ign1x.OhMyIme.Settings.desktop"
}

package_oh-my-ime-rime-bin() {
@RIME_METADATA@
  _install_component rime oh-my-ime-rime-bin
}
