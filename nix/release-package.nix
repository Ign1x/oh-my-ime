# Copied as package.nix and rime.nix in the release flake. The latter passes
# component = "rime" through the small wrapper generated by scripts/release.py.
{
  callPackage,
  fetchurl,
  stdenv,
  component ? "platform",
}:
let
  release = builtins.fromJSON (builtins.readFile ./release.json);
  artifact = release.artifacts.${stdenv.hostPlatform.system}.${component};
in
callPackage ./binary.nix {
  inherit (release) version;
  src = fetchurl { inherit (artifact) url hash; };
  rime = component == "rime";
}
